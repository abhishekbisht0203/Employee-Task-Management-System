{
  "info": {
    "name": "Employee Task Management System API",
    "description": "API documentation for the Employee Task Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventxplora.com\",\n  \"password\": \"admin123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Employees",
      "item": [
        {
          "name": "Get All Employees",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "employees"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Create Employee",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/admin/employees",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "employees"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Smith\",\n  \"email\": \"jane@eventxplora.com\",\n  \"password\": \"password123\",\n  \"department\": \"Design\"\n}"
            }
          }
        },
        {
          "name": "Update Employee",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/admin/employees/2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "employees", "2"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Smith Updated\",\n  \"department\": \"Product\",\n  \"isActive\": true\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/admin/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "tasks"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Fix login page bug\",\n  \"description\": \"Users cannot login with special characters in password\",\n  \"assignedTo\": 2,\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2026-08-10\"\n}"
            }
          }
        },
        {
          "name": "Get All Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "tasks"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Get Tasks (Filtered)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/tasks?status=PENDING&employeeId=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "tasks"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "employeeId", "value": "2" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        },
        {
          "name": "Get Task Work Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/tasks/1/worklogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "tasks", "1", "worklogs"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Admin - Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "dashboard", "stats"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Employee - Tasks",
      "item": [
        {
          "name": "Get My Tasks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/employee/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employee", "tasks"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ]
          }
        },
        {
          "name": "Update Task Status",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/employee/tasks/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employee", "tasks", "1", "status"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            }
          }
        },
        {
          "name": "Add Work Log",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/employee/tasks/1/worklogs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employee", "tasks", "1", "worklogs"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Fixed the validation logic and added unit tests\"\n}"
            }
          }
        },
        {
          "name": "Get Task History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/employee/tasks/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employee", "tasks", "history"]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminToken",
      "value": "replace-with-admin-jwt-token"
    },
    {
      "key": "employeeToken",
      "value": "replace-with-employee-jwt-token"
    }
  ]
}